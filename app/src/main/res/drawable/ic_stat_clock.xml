<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar mark for a running clock. Status icons are drawn by the system
  in a single colour from the alpha channel alone, so this is white strokes on
  nothing — the same clock face the app uses, at the weight the bar expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,3a9,9 0,1 0,0.0001 0zM12,7v5l3.5,2" />
</vector>
