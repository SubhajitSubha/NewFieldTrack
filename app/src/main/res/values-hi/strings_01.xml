    <string name="sync_all_safe">सब कुछ बैकअप हो गया है</string>
    <string name="sync_all_safe_body">इस फ़ोन का हर काम, पेमेंट और ग्राहक सर्वर पर भी है।</string>
    <string name="sync_sending">बैकअप हो रहा है…</string>
    <string name="sync_sending_body">जो बाकी है, वह भेजा जा रहा है। आप काम करते रहिए — यह पीछे अपने-आप चलता रहेगा।</string>
    <string name="sync_never">अभी तक बैकअप नहीं हुआ</string>
    <string name="sync_nothing_waiting">ऊपर जाने को कुछ बाकी नहीं</string>
    <string name="sync_nothing_waiting_body">इस फ़ोन में कुछ भी सर्वर के इंतज़ार में नहीं है। अब से जो काम आप दर्ज करेंगे, वह अपने-आप ऊपर चला जाएगा।</string>
    <string name="sync_waiting_title">सिग्नल का इंतज़ार</string>
    <string name="sync_blocked_title">एक बदलाव सेव नहीं हो पाया</string>
    <string name="sync_blocked_body">आपका काम इस फ़ोन में सुरक्षित है, कुछ भी खोया नहीं है। सर्वर ने एक बदलाव नहीं लिया, इसलिए उसके बाद वाले उसके पीछे रुके हैं।</string>
    <string name="sync_no_backend_title">बैकअप चालू नहीं है</string>
    <string name="sync_no_backend_body">सब कुछ इस फ़ोन में सेव है और रखा हुआ है। बैकअप चालू होते ही ऊपर चला जाएगा।</string>
