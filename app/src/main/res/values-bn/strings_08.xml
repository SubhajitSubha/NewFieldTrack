    <string name="help_q_record">কাজ কীভাবে লিখব?</string>
    <string name="help_a_record">হোম স্ক্রিনে \"কাজ শুরু করুন\" চাপুন। কৃষক আর মেশিন বাছুন, তারপর ঘড়ি চালু করুন। কাজ শেষ হলে পরিমাণ দেখে নিয়ে বিল মেটান। আগে করা কাজ \"আগে করা কাজ\" দিয়ে যোগ করা যায়।</string>
    <string name="help_q_driver">চালককে কীভাবে যোগ করব?</string>
    <string name="help_a_driver">\"আরও\" খুলুন, তারপর \"আমার দল\", আর \"চালককে ডাকুন\" বাছুন। কোডটি পাঠিয়ে দিন। তাঁরা অ্যাপ খুলে \"যোগ দিন\" বেছে কোডটি লিখবেন। তাঁরা কী দেখবেন আর করবেন তা আপনি ঠিক করেন।</string>
    <string name="help_q_offline">নেটওয়ার্ক ছাড়া কি চলে?</string>
    <string name="help_a_offline">হ্যাঁ। সব আগে আপনার ফোনে সেভ হয়, নেটওয়ার্ক পেলে চলে যায়। \"আরও\", তারপর \"ব্যাকআপ\"-এ দেখা যায় কী বাকি আছে।</string>
    <string name="help_q_part">একজন কৃষক বিলের কিছুটা দিয়েছেন।</string>
    <string name="help_a_part">কৃষককে খুলুন আর \"টাকা পেয়েছি\" চাপুন। তাঁর খাতায় যা বাকি তা থাকে, আর সবচেয়ে পুরনো বিল আগে মেটে।</string>
    <string name="help_q_share">বিল বা হিসাবের কাগজ কীভাবে পাঠাব?</string>
    <string name="help_a_share">কাজ বা কৃষককে খুলুন আর \"পাঠান\" চাপুন। এতে একটি PDF হয় যা হোয়াটসঅ্যাপে পাঠাতে বা ছাপাতে পারেন। বাকি টাকার মনে করানো কৃষকের পাতায় আছে।</string>
    <string name="help_q_phone">আমি ফোন বদলেছি।</string>
    <string name="help_a_phone">একই ফোন নম্বর দিয়ে ঢুকুন, বা প্রোফাইলে গুগল যোগ করে থাকলে গুগল দিয়ে। আপনার খাতাপত্র ফিরে আসবে। পুরনো ফোনে যা এখনও পাঠানো হয়নি তা সেখানেই থাকে, তাই আগে পাঠিয়ে দিন।</string>
    <string name="help_q_money">আমার টাকার হিসাব কে দেখতে পায়?</string>
    <string name="help_a_money">শুধু যাঁদের আপনি অনুমতি দেন। \"আমার দল\"-এ প্রত্যেকের জন্য সুইচ আছে, তাঁরা কী দেখবেন আর করবেন তার। \"শুধু দেখেন\" যাঁরা, তাঁরা দেখতে পারেন কিন্তু কিছু বদলাতে পারেন না।</string>
    <string name="help_q_export">আমার খাতাপত্র কীভাবে বের করব?</string>
